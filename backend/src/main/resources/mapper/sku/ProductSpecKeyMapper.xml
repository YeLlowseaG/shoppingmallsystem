<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shoppingmall.repository.sku.ProductSpecKeyRepository">

    <!-- 根据商品ID查询规格属性列表 -->
    <select id="findByProductId" parameterType="java.lang.Long" resultType="com.shoppingmall.entity.ProductSpecKey">
        SELECT * FROM product_spec_key 
        WHERE product_id = #{productId}
        ORDER BY sort_order ASC, id ASC
    </select>
    
    <!-- 根据商品ID删除规格属性 -->
    <delete id="deleteByProductId" parameterType="java.lang.Long">
        DELETE FROM product_spec_key WHERE product_id = #{productId}
    </delete>

</mapper>