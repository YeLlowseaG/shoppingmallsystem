        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - 计算签名" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.security.MessageDigest;
import java.nio.charset.StandardCharsets;
import java.util.TreeMap;
import groovy.json.JsonBuilder;

// 获取配置参数
def appSecret = vars.get(&quot;appSecret&quot;);
def accessToken = vars.get(&quot;accessToken&quot;);
def appKey = vars.get(&quot;appKey&quot;);

// 生成时间戳（秒）
def timestamp = System.currentTimeMillis() / 1000;
def timestampStr = String.valueOf((long)timestamp);

// 构建items参数
def itemsData = [
    items: [
        [
            sku_id: &quot;56&quot;,
            i_id: &quot;BM00001&quot;,
            name: &quot;erp测试商品01-一个sku&quot;
        ]
    ]
];
def jsonBuilder = new JsonBuilder(itemsData);
def items = jsonBuilder.toString();

// 设置items和时间戳到变量
vars.put(&quot;items&quot;, items);
vars.put(&quot;timestamp&quot;, timestampStr);

// 构建参数Map（按key排序）
def params = new TreeMap&lt;String, String&gt;();
params.put(&quot;access_token&quot;, accessToken);
params.put(&quot;app_key&quot;, appKey);
params.put(&quot;charset&quot;, &quot;utf-8&quot;);
params.put(&quot;items&quot;, items);
params.put(&quot;timestamp&quot;, timestampStr);
params.put(&quot;version&quot;, &quot;2&quot;);

// 拼接签名字符串
def signString = new StringBuilder(appSecret);
for (def entry : params.entrySet()) {
    signString.append(entry.getKey()).append(entry.getValue());
}
signString.append(appSecret);

// 计算MD5并转大写
def md = MessageDigest.getInstance(&quot;MD5&quot;);
def digest = md.digest(signString.toString().getBytes(StandardCharsets.UTF_8));
def sign = digest.encodeHex().toString().toUpperCase();

// 设置签名到变量
vars.put(&quot;sign&quot;, sign);

// 输出调试信息
log.info(&quot;===== 签名计算 =====&quot;);
log.info(&quot;时间戳: &quot; + timestampStr);
log.info(&quot;items: &quot; + items);
log.info(&quot;签名字符串: &quot; + signString.toString());
log.info(&quot;签名结果: &quot; + sign);
log.info(&quot;====================&quot;);
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
